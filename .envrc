# -*- mode: sh; sh-shell: bash -*-

export DIRENV_WARN_TIMEOUT=20s

eval "$(devenv direnvrc)"

use devenv 2>/dev/null

# direnv configuration for this Airflow deployment.
#
# This file is safe to commit: it contains NO secret values. Every credential
# lives in .envrc.private, which is gitignored. Run `direnv allow` once to
# activate.
#
# There is no OCI_CLI_AUTH here, unlike once-colors and walter-oci. That
# variable exists in those projects because the local OCI DEFAULT profile is
# session-token based and the oci CLI rejects it under the default ApiKey auth.
# This project's compute is DigitalOcean, which OpenTofu reaches with
# COLORS_PAR_DO_TOKEN and no CLI at all — so there is no session to keep alive
# and nothing to refresh before a long create.
#
# The corollary is worth knowing before you reach for it: `stop` and `start` are
# power verbs walter implements only for OCI, because membership is a fact about
# the provider's API rather than about its OpenTofu template. On DigitalOcean
# they report that the provider cannot be power cycled and exit 0 — a reported
# no-op, not a silent one. Sizing this box is therefore a decision you live with
# continuously, not one you can park overnight.

# Load COLORS_PAR_* credentials if the private file is present. Nothing here
# fails when it is missing, so `build` and `create --dry-run` still work on a
# fresh checkout — they render from desired state alone and reach no provider.
#
# Never export COLORS_PAR_PROFILE, here or in any shell that runs this project.
# The profile is the only thing separating this project's OpenTofu state from
# once-colors' and walter-oci's, and the overlay happens before any step runs.
source_env_if_exists .envrc.private
